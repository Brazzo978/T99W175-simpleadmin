[Unit]
Description=Diag Radio Metrics Daemon
After=network.target
# The binary lives in /data/simpleadmin/bin (/usr/bin/diag_bridge links to it).
RequiresMountsFor=/data

[Service]
Type=forking
ExecStart=/usr/bin/diag_bridge -i bridge0
PIDFile=/run/diag_bridge.pid
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
