#!/bin/bash
# Per-SIM profiles: APN, PDP type and TTL/HL keyed by ICCID, applied by
# /opt/scripts/sim-profiles/sim-profiles when the active SIM changes.
#   GET               the profiles, the active SIM with its current settings,
#                     and the last apply
#   GET ?status=1     progress of the running or last apply
#   POST (admin)      JSON, one of
#     {"action":"save","iccid":"...","previousIccid":"...","name":"...",
#      "apn":"...","pdpType":"IP|IPV6|IPV4V6","ttl":"0-255 or empty"}
#     {"action":"delete","iccid":"..."}
#     {"action":"apply","iccid":"..."}  started in the background; answers
#                                       its id, then poll ?status=1
set -eu

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
. "$SCRIPT_DIR/session_utils.sh"

DIR="/data/simpleadmin/sim-profiles"
SIM_PROFILES="/opt/scripts/sim-profiles/sim-profiles"
STATUS_FILE="/tmp/sim-profiles.apply"
LOCK_FILE="/tmp/sim-profiles.lock"

if ! session_load; then
    send_json_response 401 '{"success":false,"message":"Authentication required"}'
    exit 0
fi

fail() {
    send_json_response "$1" "{\"success\":false,\"message\":\"$2\"${3:+,\"error\":\"$3\"}}"
    exit 0
}

# kv FILE KEY: value of KEY=value in FILE.
kv() {
    sed -n "s/^$2=//p" "$1" 2>/dev/null | head -n 1
}

valid_iccid() {
    [[ "$1" =~ ^[0-9]{18,22}$ ]]
}

# The apply status is JSON the script writes; anything else reads as none.
last_apply() {
    local status=""
    [ -f "$STATUS_FILE" ] && status="$(head -n 1 "$STATUS_FILE")"
    if [[ "$status" == '{"id":'*'}' ]]; then
        printf '%s' "$status"
    else
        printf 'null'
    fi
}

profiles_json() {
    local f iccid ttl updated first=1
    printf '['
    for f in "$DIR"/*.conf; do
        [ -f "$f" ] || continue
        iccid="$(basename "$f" .conf)"
        valid_iccid "$iccid" || continue
        ttl="$(kv "$f" TTL)"
        [[ "$ttl" =~ ^[0-9]{0,3}$ ]] || ttl=""
        updated="$(kv "$f" UPDATED)"
        [[ "$updated" =~ ^[0-9]+$ ]] || updated=0
        [ "$first" = 1 ] || printf ','
        first=0
        printf '{"iccid":"%s","name":"%s","apn":"%s","pdpType":"%s","ttl":"%s","updated":%s}' \
            "$iccid" "$(json_escape "$(kv "$f" NAME)")" "$(json_escape "$(kv "$f" APN)")" \
            "$(json_escape "$(kv "$f" PDP_TYPE)")" "$ttl" "$updated"
    done
    printf ']'
}

post_str() {
    printf '%s' "$POST_DATA" | sed -n "s/.*\"$1\":[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -n 1
}

case "${REQUEST_METHOD:-GET}" in
    GET)
        if [[ "${QUERY_STRING:-}" == *status=* ]]; then
            status="$(last_apply)"
            [ "$status" = "null" ] && status='{"status":"idle"}'
            send_json_response 200 "$status"
            exit 0
        fi

        installed=false
        active="null"
        current="null"
        if [ -x "$SIM_PROFILES" ]; then
            installed=true
            settings="$("$SIM_PROFILES" current 2>/dev/null || true)"
            iccid="$(printf '%s\n' "$settings" | sed -n 's/^ICCID=//p')"
            slot="$(printf '%s\n' "$settings" | sed -n 's/^SLOT=//p')"
            apn="$(printf '%s\n' "$settings" | sed -n 's/^APN=//p')"
            pdp="$(printf '%s\n' "$settings" | sed -n 's/^PDP_TYPE=//p')"
            ttl="$(printf '%s\n' "$settings" | sed -n 's/^TTL=//p')"
            [[ "$slot" =~ ^[12]$ ]] || slot=0
            [[ "$ttl" =~ ^[0-9]{1,3}$ ]] || ttl=0
            if valid_iccid "$iccid"; then
                active="{\"iccid\":\"$iccid\",\"slot\":$slot,\"simReady\":true}"
            else
                active="{\"iccid\":\"\",\"slot\":$slot,\"simReady\":false}"
            fi
            current="{\"apn\":\"$(json_escape "$apn")\",\"pdpType\":\"$(json_escape "$pdp")\",\"ttl\":$ttl}"
        fi

        send_json_response 200 "{\"success\":true,\"installed\":$installed,\"active\":$active,\"current\":$current,\"profiles\":$(profiles_json),\"lastApply\":$(last_apply)}"
        ;;

    POST)
        if ! session_require_role "admin"; then
            fail 403 "Admin privileges required"
        fi
        if [ -n "${CONTENT_LENGTH:-}" ]; then
            POST_DATA="$(head -c "$CONTENT_LENGTH")"
        else
            POST_DATA=""
        fi
        action="$(post_str action)"
        iccid="$(post_str iccid)"
        valid_iccid "$iccid" || fail 400 "The ICCID is 18 to 22 digits"

        case "$action" in
            save)
                previous="$(post_str previousIccid)"
                name="$(post_str name | sed 's/^ *//; s/ *$//')"
                apn="$(post_str apn)"
                pdp="$(post_str pdpType)"
                ttl="$(post_str ttl)"
                name_re='^[A-Za-z0-9 ._()+-]{1,32}$'
                apn_re='^[A-Za-z0-9._-]{0,63}$'
                [[ "$name" =~ $name_re ]] ||
                    fail 400 "Name: 1 to 32 letters, digits, spaces and . _ ( ) + -"
                [[ "$apn" =~ $apn_re ]] ||
                    fail 400 "APN: letters, digits, dot, dash and underscore, at most 63"
                case "$pdp" in
                    IP|IPV6|IPV4V6) ;;
                    *) fail 400 "PDP type: IP, IPV6 or IPV4V6" ;;
                esac
                if [ -n "$ttl" ]; then
                    [[ "$ttl" =~ ^[0-9]{1,3}$ ]] && [ "$((10#$ttl))" -le 255 ] ||
                        fail 400 "TTL: 0 to 255, or empty to leave it as it is"
                    ttl="$((10#$ttl))"
                fi
                [ -n "$apn$ttl" ] || fail 400 "Set an APN, a TTL, or both"

                mkdir -p "$DIR"
                printf 'NAME=%s\nAPN=%s\nPDP_TYPE=%s\nTTL=%s\nUPDATED=%s\n' \
                    "$name" "$apn" "$pdp" "$ttl" "$(date +%s)" > "$DIR/$iccid.conf.tmp"
                mv -f "$DIR/$iccid.conf.tmp" "$DIR/$iccid.conf"
                if [ -n "$previous" ] && [ "$previous" != "$iccid" ] && valid_iccid "$previous"; then
                    rm -f "$DIR/$previous.conf"
                fi
                send_json_response 200 "{\"success\":true,\"profiles\":$(profiles_json)}"
                ;;
            delete)
                rm -f "$DIR/$iccid.conf"
                send_json_response 200 "{\"success\":true,\"profiles\":$(profiles_json)}"
                ;;
            apply)
                [ -x "$SIM_PROFILES" ] ||
                    fail 503 "sim-profiles is not installed: run install.sh without --onlywww"
                [ -f "$DIR/$iccid.conf" ] || fail 404 "No profile for this ICCID"
                # The lock is taken here and inherited by the worker on fd 9,
                # so two requests can never both start a run.
                exec 9>"$LOCK_FILE"
                if ! flock -n 9; then
                    fail 409 "A profile is being applied" "apply_in_progress"
                fi
                id="$(date +%s)-$$"
                setsid "$SIM_PROFILES" apply "$iccid" "$id" --locked </dev/null >/dev/null 2>&1 &
                exec 9>&-
                send_json_response 200 "{\"success\":true,\"id\":\"$id\"}"
                ;;
            *)
                fail 400 "Unknown action"
                ;;
        esac
        ;;

    *)
        fail 405 "Unsupported method"
        ;;
esac
