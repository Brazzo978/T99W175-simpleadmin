#!/bin/bash
set -eu

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
. "$SCRIPT_DIR/session_utils.sh"

WATCHDOG_FILE="/opt/scripts/Watchdog"
SERVICE_NAME="connection-watchdog.service"
# A slot that showed no SIM is skipped by tier 3 for a while; saving the
# configuration gives it another chance.
UNUSABLE_FILE="/data/simpleadmin/watchdog/sim-unusable"

json_escape() {
    local str="$1"
    str="${str//\\/\\\\}"
    str="${str//\"/\\\"}"
    str="${str//$'\n'/\\n}"
    str="${str//$'\r'/\\r}"
    str="${str//$'\t'/\\t}"
    printf '%s' "$str"
}

load_defaults() {
    WD_ENABLED="0"
    WD_TARGETS="1.1.1.1,8.8.8.8"
    WD_FAIL_COUNT="3"
    WD_CHECK_INTERVAL="10"
    WD_PING_TIMEOUT_SEC=""
    WD_PING_TIMEOUT_MS=""
    WD_PING_TIMEOUT=""
    WD_ACTION="cfun"
    WD_CFUN_DELAY="5"
    WD_CFUN_MAX_ATTEMPTS="1"
    WD_BOOT_GRACE="600"
    WD_RECOVERY_COOLDOWN="120"
    WD_TIER1_ENABLED=""
    WD_TIER2_ENABLED=""
    WD_TIER3_ENABLED=""
    WD_TIER4_ENABLED=""
    WD_TIER1_SETTLE="30"
    WD_TIER2_SETTLE="60"
    WD_TIER3_SETTLE="120"
    WD_SIM_REVERT="timer"
    WD_SIM_REVERT_AFTER="3600"
    WD_MAX_RECOVERIES_PER_HOUR="6"
    WD_MAX_REBOOTS_PER_DAY="3"
}

# clamp NAME DEFAULT MIN MAX, as the watchdog reads its file.
clamp() {
    local v="${!1:-}"
    [[ "$v" =~ ^[0-9]+$ ]] || v="$2"
    v=$((10#$v))
    [ "$v" -ge "$3" ] || v="$3"
    [ "$v" -le "$4" ] || v="$4"
    printf -v "$1" '%s' "$v"
}

flag() {
    case "${!1:-}" in
        0|1) ;;
        *) printf -v "$1" '%s' "$2" ;;
    esac
}

load_config() {
    load_defaults
    if [ -f "$WATCHDOG_FILE" ]; then
        # shellcheck disable=SC1090
        . "$WATCHDOG_FILE"
    fi

    if [ -z "${WD_PING_TIMEOUT_SEC:-}" ] && [ -n "${WD_PING_TIMEOUT_MS:-}" ]; then
        clamp WD_PING_TIMEOUT_MS 5000 1 60000
        WD_PING_TIMEOUT_SEC=$(((WD_PING_TIMEOUT_MS + 999) / 1000))
    fi
    if [ -z "${WD_PING_TIMEOUT_SEC:-}" ] && [ -n "${WD_PING_TIMEOUT:-}" ]; then
        WD_PING_TIMEOUT_SEC="$WD_PING_TIMEOUT"
    fi

    # Written before the tiers: WD_ACTION chose radio restarts or reboot.
    if [ -f "$WATCHDOG_FILE" ] && \
       [ -z "$WD_TIER1_ENABLED$WD_TIER2_ENABLED$WD_TIER3_ENABLED$WD_TIER4_ENABLED" ]; then
        WD_TIER1_ENABLED="0"
        WD_TIER3_ENABLED="0"
        WD_TIER4_ENABLED="1"
        if [ "$WD_ACTION" = "reboot" ]; then
            WD_TIER2_ENABLED="0"
        else
            WD_TIER2_ENABLED="1"
        fi
    fi

    flag WD_ENABLED 0
    flag WD_TIER1_ENABLED 1
    flag WD_TIER2_ENABLED 1
    flag WD_TIER3_ENABLED 0
    flag WD_TIER4_ENABLED 1
    clamp WD_FAIL_COUNT 3 1 120
    clamp WD_CHECK_INTERVAL 10 1 60
    clamp WD_PING_TIMEOUT_SEC 5 1 60
    clamp WD_CFUN_DELAY 5 1 120
    clamp WD_CFUN_MAX_ATTEMPTS 1 1 120
    clamp WD_BOOT_GRACE 600 0 3600
    clamp WD_RECOVERY_COOLDOWN 120 0 3600
    clamp WD_TIER1_SETTLE 30 10 600
    clamp WD_TIER2_SETTLE 60 10 600
    clamp WD_TIER3_SETTLE 120 30 900
    clamp WD_SIM_REVERT_AFTER 3600 300 86400
    clamp WD_MAX_RECOVERIES_PER_HOUR 6 1 60
    clamp WD_MAX_REBOOTS_PER_DAY 3 1 24
    [ "$WD_SIM_REVERT" = "never" ] || WD_SIM_REVERT="timer"
}

save_config() {
    # The classic pages still read "action": radio restarts or reboot only.
    WD_ACTION=$([ "$WD_TIER2_ENABLED" = "1" ] && echo "cfun" || echo "reboot")
    mkdir -p "$(dirname "$WATCHDOG_FILE")"
    cat > "$WATCHDOG_FILE.tmp" <<CFG
# Connection watchdog configuration
# Generated by SimpleAdmin GUI
WD_ENABLED="$WD_ENABLED"
WD_TARGETS="$WD_TARGETS"
WD_FAIL_COUNT="$WD_FAIL_COUNT"
WD_CHECK_INTERVAL="$WD_CHECK_INTERVAL"
WD_PING_TIMEOUT_SEC="$WD_PING_TIMEOUT_SEC"
WD_BOOT_GRACE="$WD_BOOT_GRACE"
WD_RECOVERY_COOLDOWN="$WD_RECOVERY_COOLDOWN"
WD_TIER1_ENABLED="$WD_TIER1_ENABLED"
WD_TIER1_SETTLE="$WD_TIER1_SETTLE"
WD_TIER2_ENABLED="$WD_TIER2_ENABLED"
WD_TIER2_SETTLE="$WD_TIER2_SETTLE"
WD_CFUN_DELAY="$WD_CFUN_DELAY"
WD_CFUN_MAX_ATTEMPTS="$WD_CFUN_MAX_ATTEMPTS"
WD_TIER3_ENABLED="$WD_TIER3_ENABLED"
WD_TIER3_SETTLE="$WD_TIER3_SETTLE"
WD_SIM_REVERT="$WD_SIM_REVERT"
WD_SIM_REVERT_AFTER="$WD_SIM_REVERT_AFTER"
WD_TIER4_ENABLED="$WD_TIER4_ENABLED"
WD_MAX_RECOVERIES_PER_HOUR="$WD_MAX_RECOVERIES_PER_HOUR"
WD_MAX_REBOOTS_PER_DAY="$WD_MAX_REBOOTS_PER_DAY"
WD_ACTION="$WD_ACTION"
CFG
    mv -f "$WATCHDOG_FILE.tmp" "$WATCHDOG_FILE"
}

service_control() {
    local enabled="$1"

    if command -v systemctl >/dev/null 2>&1; then
        if [ "$enabled" = "1" ]; then
            systemctl enable "$SERVICE_NAME" >/dev/null 2>&1 || true
            systemctl restart "$SERVICE_NAME" >/dev/null 2>&1 || true
        else
            systemctl disable "$SERVICE_NAME" >/dev/null 2>&1 || true
            systemctl stop "$SERVICE_NAME" >/dev/null 2>&1 || true
        fi
    elif command -v service >/dev/null 2>&1; then
        if [ "$enabled" = "1" ]; then
            service connection-watchdog restart >/dev/null 2>&1 || true
        else
            service connection-watchdog stop >/dev/null 2>&1 || true
        fi
    fi
}

validate_ipv4_csv() {
    local input="$1"
    local IFS=','
    local item octet

    [ -n "$input" ] || return 1

    for item in $input; do
        item="$(echo "$item" | xargs)"
        echo "$item" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
        IFS='.' read -r o1 o2 o3 o4 <<EOI
$item
EOI
        for octet in "$o1" "$o2" "$o3" "$o4"; do
            [ "$octet" -ge 0 ] 2>/dev/null && [ "$octet" -le 255 ] 2>/dev/null || return 1
        done
    done

    return 0
}

bool() {
    [ "$1" = "1" ] && echo true || echo false
}

config_json() {
    cat <<JSON
{
  "success":true,
  "enabled":$(bool "$WD_ENABLED"),
  "targets":"$(json_escape "$WD_TARGETS")",
  "failCount":$WD_FAIL_COUNT,
  "checkInterval":$WD_CHECK_INTERVAL,
  "pingTimeoutSec":$WD_PING_TIMEOUT_SEC,
  "pingTimeoutMs":$((WD_PING_TIMEOUT_SEC * 1000)),
  "action":"$([ "$WD_TIER2_ENABLED" = "1" ] && echo cfun || echo reboot)",
  "cfunDelay":$WD_CFUN_DELAY,
  "cfunMaxAttempts":$WD_CFUN_MAX_ATTEMPTS,
  "bootGrace":$WD_BOOT_GRACE,
  "recoveryCooldown":$WD_RECOVERY_COOLDOWN,
  "tier1Enabled":$(bool "$WD_TIER1_ENABLED"),
  "tier2Enabled":$(bool "$WD_TIER2_ENABLED"),
  "tier3Enabled":$(bool "$WD_TIER3_ENABLED"),
  "tier4Enabled":$(bool "$WD_TIER4_ENABLED"),
  "tier1Settle":$WD_TIER1_SETTLE,
  "tier2Settle":$WD_TIER2_SETTLE,
  "tier3Settle":$WD_TIER3_SETTLE,
  "simRevert":"$WD_SIM_REVERT",
  "simRevertAfter":$WD_SIM_REVERT_AFTER,
  "maxRecoveriesPerHour":$WD_MAX_RECOVERIES_PER_HOUR,
  "maxRebootsPerDay":$WD_MAX_REBOOTS_PER_DAY
}
JSON
}

bad_request() {
    send_json_response 400 "{\"success\":false,\"message\":\"$1\"}"
    exit 0
}

# Field readers on the flat JSON body: empty when the key is absent.
post_num() {
    printf '%s' "$POST_DATA" | sed -n "s/.*\"$1\":[[:space:]]*\([0-9]\+\).*/\1/p" | head -n 1
}
post_bool() {
    printf '%s' "$POST_DATA" | sed -n "s/.*\"$1\":[[:space:]]*\(true\|false\).*/\1/p" | head -n 1
}
post_str() {
    printf '%s' "$POST_DATA" | sed -n "s/.*\"$1\":[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -n 1
}

# set_num FIELD VAR MIN MAX: VAR takes FIELD when it is posted, in range.
set_num() {
    local value
    value="$(post_num "$1")"
    [ -n "$value" ] || return 0
    value=$((10#$value))
    [ "$value" -ge "$3" ] && [ "$value" -le "$4" ] || bad_request "Invalid $1"
    printf -v "$2" '%s' "$value"
}

set_bool() {
    local value
    value="$(post_bool "$1")"
    [ -n "$value" ] || return 0
    printf -v "$2" '%s' "$([ "$value" = "true" ] && echo 1 || echo 0)"
}

if ! session_load; then
    send_json_response 401 '{"success":false,"message":"Authentication required"}'
    exit 0
fi

if [ "$REQUEST_METHOD" = "POST" ] && ! session_require_role "admin"; then
    send_json_response 403 '{"success":false,"message":"Admin privileges required"}'
    exit 0
fi

case "$REQUEST_METHOD" in
    GET)
        load_config
        send_json_response 200 "$(config_json)"
        ;;
    POST)
        if [ -n "${CONTENT_LENGTH:-}" ]; then
            POST_DATA=$(head -c "$CONTENT_LENGTH")
        else
            POST_DATA=""
        fi

        load_config

        enabled="$(post_bool enabled)"
        targets="$(post_str targets)"
        action="$(post_str action)"
        ping_timeout_ms="$(post_num pingTimeoutMs)"

        [ "$enabled" = "true" ] || [ "$enabled" = "false" ] || bad_request "Invalid enabled value"
        validate_ipv4_csv "$targets" || bad_request "Invalid targets list"
        [ -n "$(post_num failCount)" ] || bad_request "Invalid failCount"
        [ -n "$(post_num checkInterval)" ] || bad_request "Invalid checkInterval"
        [ -n "$(post_num bootGrace)" ] || bad_request "Invalid bootGrace"
        if [ -z "$(post_num pingTimeoutSec)" ]; then
            [ -n "$ping_timeout_ms" ] || bad_request "Invalid pingTimeoutSec"
            WD_PING_TIMEOUT_SEC=$(((10#$ping_timeout_ms + 999) / 1000))
            [ "$WD_PING_TIMEOUT_SEC" -ge 1 ] && [ "$WD_PING_TIMEOUT_SEC" -le 60 ] || bad_request "Invalid pingTimeoutSec"
        fi

        WD_ENABLED=$([ "$enabled" = "true" ] && echo "1" || echo "0")
        WD_TARGETS="$targets"
        set_num failCount WD_FAIL_COUNT 1 120
        set_num checkInterval WD_CHECK_INTERVAL 1 60
        set_num pingTimeoutSec WD_PING_TIMEOUT_SEC 1 60
        set_num bootGrace WD_BOOT_GRACE 0 3600
        set_num recoveryCooldown WD_RECOVERY_COOLDOWN 0 3600
        set_num cfunDelay WD_CFUN_DELAY 1 120
        set_num cfunMaxAttempts WD_CFUN_MAX_ATTEMPTS 1 120
        set_num tier1Settle WD_TIER1_SETTLE 10 600
        set_num tier2Settle WD_TIER2_SETTLE 10 600
        set_num tier3Settle WD_TIER3_SETTLE 30 900
        set_num simRevertAfter WD_SIM_REVERT_AFTER 300 86400
        set_num maxRecoveriesPerHour WD_MAX_RECOVERIES_PER_HOUR 1 60
        set_num maxRebootsPerDay WD_MAX_REBOOTS_PER_DAY 1 24

        sim_revert="$(post_str simRevert)"
        if [ -n "$sim_revert" ]; then
            [ "$sim_revert" = "never" ] || [ "$sim_revert" = "timer" ] || bad_request "Invalid simRevert"
            WD_SIM_REVERT="$sim_revert"
        fi

        if [ -n "$(post_bool tier1Enabled)$(post_bool tier2Enabled)$(post_bool tier3Enabled)$(post_bool tier4Enabled)" ]; then
            set_bool tier1Enabled WD_TIER1_ENABLED
            set_bool tier2Enabled WD_TIER2_ENABLED
            set_bool tier3Enabled WD_TIER3_ENABLED
            set_bool tier4Enabled WD_TIER4_ENABLED
        elif [ -n "$action" ]; then
            # The classic pages only know radio restarts or reboot.
            case "$action" in
                cfun) WD_TIER2_ENABLED="1"; WD_TIER4_ENABLED="1" ;;
                reboot) WD_TIER1_ENABLED="0"; WD_TIER2_ENABLED="0"; WD_TIER3_ENABLED="0"; WD_TIER4_ENABLED="1" ;;
                *) bad_request "Invalid action" ;;
            esac
        fi

        save_config
        rm -f "$UNUSABLE_FILE"
        service_control "$WD_ENABLED"

        send_json_response 200 "$(config_json)"
        ;;
    *)
        send_json_response 405 '{"success":false,"message":"Unsupported method"}'
        ;;
esac
