#!/bin/bash
# Recent watchdog actions and its live state, for the Connection Monitoring
# page: GET ?limit=N (default 50, at most 200), newest event first.
#   events       the JSON lines of /tmp/connection-watchdog.events
#   status       /tmp/connection-watchdog.status (state, tier, failures)
#   limits       actions in the last hour and reboots in the last 24 hours,
#                from /data/simpleadmin/watchdog/recoveries
#   simFailover  /data/simpleadmin/watchdog/sim-failover, when the watchdog
#                switched to the other SIM
set -eu

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
. "$SCRIPT_DIR/session_utils.sh"

WATCHDOG_FILE="/opt/scripts/Watchdog"
EVENTS_FILE="/tmp/connection-watchdog.events"
STATUS_FILE="/tmp/connection-watchdog.status"
STATE_DIR="/data/simpleadmin/watchdog"
RECOVERIES_FILE="$STATE_DIR/recoveries"
FAILOVER_FILE="$STATE_DIR/sim-failover"
DEFAULT_LIMIT=50
MAX_LIMIT=200

if ! session_load; then
    send_json_response 401 '{"success":false,"message":"Authentication required"}'
    exit 0
fi

limit="$DEFAULT_LIMIT"
req="$(printf '%s' "${QUERY_STRING:-}" | sed -n 's/.*limit=\([0-9]\{1,4\}\).*/\1/p')"
[ -n "$req" ] && limit=$((10#$req))
[ "$limit" -ge 1 ] || limit=1
[ "$limit" -le "$MAX_LIMIT" ] || limit="$MAX_LIMIT"

# kv FILE KEY: KEY=value lines written by the watchdog.
kv() {
    sed -n "s/^$2=\"\{0,1\}\([^\"]*\)\"\{0,1\}$/\1/p" "$1" 2>/dev/null | head -n 1
}

num() {
    [[ "${1:-}" =~ ^[0-9]+$ ]] && printf '%s' "$1" || printf '%s' "${2:-0}"
}

# Only whole lines the watchdog wrote: {"ts":N,...}.
events="$(tail -n "$limit" "$EVENTS_FILE" 2>/dev/null |
    grep -E '^\{"ts":[0-9]+,"tier":[0-4],"event":"[a-z_]+","result":"[a-z]+","detail":"[^"\\]*"\}$' |
    sed '1!G;h;$!d' | awk 'NR > 1 { printf "," } { printf "%s", $0 }' || true)"

state="stopped"
tier=0
fail_streak=0
updated=0
note=""
if [ -f "$STATUS_FILE" ]; then
    state="$(kv "$STATUS_FILE" STATE)"
    [[ "$state" =~ ^[a-z]+$ ]] || state="unknown"
    tier="$(num "$(kv "$STATUS_FILE" TIER)")"
    fail_streak="$(num "$(kv "$STATUS_FILE" FAIL_STREAK)")"
    updated="$(num "$(kv "$STATUS_FILE" UPDATED)")"
    note="$(kv "$STATUS_FILE" NOTE)"
fi
if ! systemctl is-active connection-watchdog.service >/dev/null 2>&1; then
    state="stopped"
fi

max_hour=6
max_day=3
if [ -f "$WATCHDOG_FILE" ]; then
    max_hour="$(num "$(kv "$WATCHDOG_FILE" WD_MAX_RECOVERIES_PER_HOUR)" 6)"
    max_day="$(num "$(kv "$WATCHDOG_FILE" WD_MAX_REBOOTS_PER_DAY)" 3)"
fi
now="$(date +%s)"
recent_hour=0
recent_day=0
if [ -f "$RECOVERIES_FILE" ]; then
    recent_hour="$(awk -v since="$((now - 3600))" '$1 >= since { n++ } END { print n + 0 }' "$RECOVERIES_FILE")"
    recent_day="$(awk -v since="$((now - 86400))" '$1 >= since && $2 == 4 { n++ } END { print n + 0 }' "$RECOVERIES_FILE")"
fi

failover='{"active":false}'
if [ -f "$FAILOVER_FILE" ]; then
    failover="$(printf '{"active":true,"originalSlot":%s,"backupSlot":%s,"since":%s}' \
        "$(num "$(kv "$FAILOVER_FILE" ORIGINAL_SLOT)")" \
        "$(num "$(kv "$FAILOVER_FILE" BACKUP_SLOT)")" \
        "$(num "$(kv "$FAILOVER_FILE" SINCE)")")"
fi

payload=$(cat <<JSON
{
  "success":true,
  "now":$now,
  "status":{"state":"$state","tier":$tier,"failStreak":$fail_streak,"updated":$updated,"note":"$(json_escape "$note")"},
  "limits":{"recoveriesLastHour":$recent_hour,"maxRecoveriesPerHour":$max_hour,"rebootsLastDay":$recent_day,"maxRebootsPerDay":$max_day},
  "simFailover":$failover,
  "events":[${events}]
}
JSON
)

send_json_response 200 "$payload"
